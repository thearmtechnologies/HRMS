<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>{{title}}</title>
  <style>
    {{{cssContent}}}
  </style>
</head>
<body>
  <div class="report-container">
    
    <!-- 1. Header Banner -->
    <div class="header-banner">
      <div class="banner-title">{{title}}</div>
      <div class="banner-date">DATE : {{generatedDateOnly}}</div>
    </div>

    <!-- 2. Metadata Box -->
    <div class="metadata-box">
      {{#if periodLabel}}
      <div class="meta-row">
        <span class="meta-label">REPORT PERIOD :</span>
        <span class="meta-value">{{periodLabel}}</span>
      </div>
      {{/if}}
      <div class="meta-row">
        <span class="meta-label">GENERATED BY :</span>
        <span class="meta-value">{{generatedBy}}</span>
      </div>
      {{#if companyName}}
      <div class="meta-row">
        <span class="meta-label">COMPANY :</span>
        <span class="meta-value">{{companyName}}</span>
      </div>
      {{/if}}
    </div>

    <!-- 3. Summary / Insights (Only render if summary has fields) -->
    {{#if hasSummary}}
    <div class="section-title">SUMMARY INSIGHTS</div>
    <div class="metrics-grid">
      {{#each summary}}
      <div class="metric-card">
        <div class="metric-label">{{@key}}</div>
        <div class="metric-value">{{this}}</div>
      </div>
      {{/each}}
    </div>
    {{/if}}

    <!-- 4. Table Section -->
    <table class="report-table">
      <thead>
        <tr>
          {{#each columns}}
          <th>{{this}}</th>
          {{/each}}
        </tr>
      </thead>
      <tbody>
        {{#each rows}}
        <tr>
          {{#each this}}
          <td>{{this}}</td>
          {{/each}}
        </tr>
        {{else}}
        <tr>
          <td colspan="{{columns.length}}" class="no-records">No records found</td>
        </tr>
        {{/each}}
      </tbody>
    </table>

  </div>
</body>
</html>
