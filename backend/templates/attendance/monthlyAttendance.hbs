<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>{{title}}</title>
  <style>
    {{{cssContent}}}
  </style>
</head>
<body>
  <div class="report-container">
    
    <!-- 1. Header Banner -->
    <div class="header-banner">
      <div class="banner-title">{{title}}</div>
      <div class="banner-date">DATE : {{generatedDateOnly}}</div>
    </div>

    <!-- 2. Metadata Box -->
    <div class="metadata-box">
      <div class="meta-row">
        <span class="meta-label">REPORT PERIOD :</span>
        <span class="meta-value">{{periodLabel}}</span>
      </div>
      <div class="meta-row">
        <span class="meta-label">GENERATED BY :</span>
        <span class="meta-value">{{generatedBy}}</span>
      </div>
      {{#if companyName}}
      <div class="meta-row">
        <span class="meta-label">COMPANY :</span>
        <span class="meta-value">{{companyName}}</span>
      </div>
      {{/if}}
    </div>

    <!-- 3. Insights / Summary Section -->
    <div class="section-title">MONTHLY INSIGHTS</div>
    <div class="metrics-grid">
      {{#each summary}}
      <div class="metric-card">
        <div class="metric-label">{{@key}}</div>
        <div class="metric-value">{{this}}</div>
      </div>
      {{/each}}
    </div>

    <!-- 4. Table Section -->
    <table class="report-table">
      <thead>
        <tr>
          <th>EMPLOYEE ID</th>
          <th>NAME</th>
          <th>DEPARTMENT</th>
          <th>SHIFT</th>
          <th>PRESENT DAYS</th>
          <th>ABSENT DAYS</th>
          <th>LATE CHECK-INS</th>
          <th>OVERTIME HOURS</th>
          <th>PAID LEAVES</th>
          <th>HOLIDAYS</th>
        </tr>
      </thead>
      <tbody>
        {{#each mappedRows}}
        <tr>
          <td>{{employeeId}}</td>
          <td><strong>{{name}}</strong></td>
          <td>{{department}}</td>
          <td>{{shift}}</td>
          <td>{{presentDays}}</td>
          <td>{{absentDays}}</td>
          <td>{{lateCheckins}}</td>
          <td>{{overtimeHours}}</td>
          <td>{{paidLeaves}}</td>
          <td>{{holidays}}</td>
        </tr>
        {{else}}
        <tr>
          <td colspan="10" class="no-records">No records found</td>
        </tr>
        {{/each}}
      </tbody>
    </table>

  </div>
</body>
</html>
