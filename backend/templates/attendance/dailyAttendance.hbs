<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>{{title}}</title>
  <style>
    {{{cssContent}}}
  </style>
</head>
<body>
  <div class="report-container">
    
    <!-- 1. Header Banner -->
    <div class="header-banner">
      <div class="banner-title">{{title}}</div>
      <div class="banner-date">DATE : {{generatedDateOnly}}</div>
    </div>

    <!-- 2. Metadata Box -->
    <div class="metadata-box">
      <div class="meta-row">
        <span class="meta-label">REPORT PERIOD :</span>
        <span class="meta-value">{{periodLabel}}</span>
      </div>
      <div class="meta-row">
        <span class="meta-label">GENERATED BY :</span>
        <span class="meta-value">{{generatedBy}}</span>
      </div>
      {{#if companyName}}
      <div class="meta-row">
        <span class="meta-label">COMPANY :</span>
        <span class="meta-value">{{companyName}}</span>
      </div>
      {{/if}}
    </div>

    <!-- 3. Insights / Summary Section -->
    {{#if hasSummary}}
    <div class="section-title">DAILY INSIGHTS</div>
    <div class="metrics-grid">
      {{#each summary}}
      <div class="metric-card">
        <div class="metric-label">{{@key}}</div>
        <div class="metric-value">{{this}}</div>
      </div>
      {{/each}}
    </div>
    {{/if}}

    <!-- 4. Table Section -->
    <table class="report-table">
      <thead>
        <tr>
          <th>EMP NAME</th>
          <th>CATEGORY</th>
          <th>STATUS</th>
          <th>IN TIME</th>
          <th>IN LOC</th>
          <th>OUT TIME</th>
          <th>OUT LOC</th>
          <th>MINUTES</th>
          <th>LATE</th>
          <th>EARLY</th>
        </tr>
      </thead>
      <tbody>
        {{#each mappedRows}}
        <tr>
          <td><strong>{{name}}</strong></td>
          <td>{{department}}</td>
          <td class="status-cell status-{{lowercase status}}">{{status}}</td>
          <td>{{checkIn}}</td>
          <td>{{inLoc}}</td>
          <td>{{checkOut}}</td>
          <td>{{outLoc}}</td>
          <td>{{workingHours}}</td>
          <td>
            {{#if isLate}}
            <span class="late-badge">L</span>
            {{else}}
            —
            {{/if}}
          </td>
          <td>{{early}}</td>
        </tr>
        {{else}}
        <tr>
          <td colspan="10" class="no-records">No records found</td>
        </tr>
        {{/each}}
      </tbody>
    </table>

  </div>
</body>
</html>
